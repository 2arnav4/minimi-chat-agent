{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A chat agent with one tool (web search) and timestamped, date-aware memory.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "loadtest:server": "tsx scripts/loadtest-server.ts",
    "loadtest": "npx -y autocannon -c 200 -d 20 -m POST -H content-type=application/json -b \"{\\\"message\\\":\\\"What is the price of Neon Postgres?\\\"}\" http://localhost:3456/api/chat"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/openai": "^4.0.114",
    "@hono/node-server": "^2.1.6",
    "ai": "^7.0.169",
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.3",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "marked": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
