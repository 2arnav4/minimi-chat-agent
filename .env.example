# --- Required: one LLM key (the agent picks the provider from whichever key is set) ---
# Gemini has a free tier (aistudio.google.com); OpenAI is paid.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Required: web search (free tier at https://tavily.com) ---
TAVILY_API_KEY=

# --- Optional ---
# Force a model (or a comma-separated fallback chain) as provider:model-id. Defaults:
# openai:gpt-5-mini, google:gemini-3.8-flash -> gemini-3.5-flash -> gemini-flash-lite-latest
MODEL=
# Fallback timezone when the browser does not send one (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata
# Gemini thinking level: low (fastest), medium, high
GEMINI_THINKING=low
PORT=3000
# Listen address. Keep 127.0.0.1; 0.0.0.0 exposes the app with no login and turns off the Host check (container use only).
HOST=127.0.0.1
# Let a request override "now" (used by the dev clock in the UI, /api/import and evals).
# Set to false in production.
ALLOW_CLOCK_OVERRIDE=true
