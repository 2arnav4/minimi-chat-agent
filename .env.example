# --- Required: one LLM key (the agent picks the provider from whichever key is set) ---
# Gemini has a free tier (aistudio.google.com); OpenAI is paid.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Required: web search (free tier at https://tavily.com) ---
TAVILY_API_KEY=

# --- Optional ---
# Force a model (or a comma-separated fallback chain) as provider:model-id. Defaults:
# openai:gpt-5-mini, google:gemini-3.8-flash -> gemini-3.5-flash -> gemini-flash-lite-latest
MODEL=
# Fallback timezone when the browser does not send one (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata
# Gemini thinking level: low (fastest), medium, high
GEMINI_THINKING=low
PORT=3000
# Listen address. Keep 127.0.0.1; 0.0.0.0 exposes the app with no login and turns off the Host check (container use only).
HOST=127.0.0.1
# LOCAL DEMO ONLY. Lets the UI Dev clock set "now" and enables /api/import (back-dated history).
# Off when unset. Remove or set to false anywhere other people can reach the app.
ALLOW_CLOCK_OVERRIDE=true
# Keep only the newest N debug traces
TRACE_KEEP=1000
# Delete messages older than N days (0 = keep all; messages are the agent's memory)
MESSAGE_RETENTION_DAYS=0
# Request limits. A rate of 0 turns that limit off.
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_IMPORT_PER_MIN=10
CHAT_MAX_BODY_BYTES=65536
IMPORT_MAX_BODY_BYTES=2097152
IMPORT_MAX_MESSAGES=500
IMPORT_MAX_MESSAGE_CHARS=20000
